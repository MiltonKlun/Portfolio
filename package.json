{
  "name": "milton-klun-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && vite build --ssr src/entry-server.tsx --outDir .server && node scripts/prerender.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:performance": "node scripts/performance.mjs"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "lighthouse": "^13.4.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
